<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mmux" model="ir.module.category">
        <field name="name">Field Multimodal UX</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_mmux_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_mmux"/>
        <field name="comment">Can use the multimodal field assistant.</field>
    </record>

    <record id="group_mmux_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_mmux"/>
        <field name="implied_ids" eval="[(4, ref('group_mmux_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configures scenarios, providers and enables L3 capabilities.</field>
    </record>
</odoo>
